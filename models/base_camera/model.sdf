<?xml version="1.0"?>
<sdf version="1.10">
    <model name="base_camera">
        <static>true</static>
        <link name="link">
            <pose>0 0 0 0 0 0</pose>

            <visual name="housing">
                <pose>0 -0.020 0 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.025 0.090 0.025</size>
                    </box>
                </geometry>
                <material>
                    <diffuse>0.2 0.2 0.2 1</diffuse>
                </material>
            </visual>

            <visual name="lens_panel">
                <pose>0.01255 -0.0175 0 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.0005 0.080 0.018</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0.02 0.02 0.02 1</ambient>
                    <diffuse>0.03 0.03 0.03 1</diffuse>
                    <specular>0.4 0.4 0.4 1</specular>
                </material>
            </visual>

            <visual name="hole_right_ir">
                <pose>0.01285 -0.050 0 0 1.5708 0</pose>
                <geometry>
                    <cylinder>
                        <radius>0.0035</radius>
                        <length>0.0002</length>
                    </cylinder>
                </geometry>
                <material>
                    <ambient>0.0 0.0 0.0 1</ambient>
                    <diffuse>0.0 0.0 0.0 1</diffuse>
                    <specular>0.6 0.6 0.6 1</specular>
                </material>
            </visual>

            <visual name="hole_ir_projector">
                <pose>0.01285 -0.025 0 0 1.5708 0</pose>
                <geometry>
                    <cylinder>
                        <radius>0.0040</radius>
                        <length>0.0002</length>
                    </cylinder>
                </geometry>
                <material>
                    <ambient>0.0 0.05 0.04 1</ambient>
                    <diffuse>0.0 0.10 0.07 1</diffuse>
                    <specular>0.3 0.6 0.5 1</specular>
                </material>
            </visual>

            <visual name="hole_left_ir">
                <pose>0.01285 0 0 0 1.5708 0</pose>
                <geometry>
                    <cylinder>
                        <radius>0.0035</radius>
                        <length>0.0002</length>
                    </cylinder>
                </geometry>
                <material>
                    <ambient>0.0 0.0 0.0 1</ambient>
                    <diffuse>0.0 0.0 0.0 1</diffuse>
                    <specular>0.6 0.6 0.6 1</specular>
                </material>
            </visual>

            <visual name="hole_color">
                <pose>0.01285 0.015 0 0 1.5708 0</pose>
                <geometry>
                    <cylinder>
                        <radius>0.0022</radius>
                        <length>0.0002</length>
                    </cylinder>
                </geometry>
                <material>
                    <ambient>0.0 0.0 0.0 1</ambient>
                    <diffuse>0.0 0.0 0.0 1</diffuse>
                    <specular>0.7 0.7 0.7 1</specular>
                </material>
            </visual>

            <sensor name="depth_camera" type="depth_camera">
                <gz_frame_id>camera_depth_optical_frame</gz_frame_id>
                <pose>0 0 0 0 0 0</pose>
                <camera>
                    <horizontal_fov>1.5184</horizontal_fov>
                    <image>
                        <width>1280</width>
                        <height>720</height>
                    </image>
                    <clip>
                        <near>0.2</near>
                        <far>19.1</far>
                    </clip>
                </camera>
                <always_on>1</always_on>
                <update_rate>30</update_rate>
                <visualize>true</visualize>
                <topic>depth_camera</topic>
            </sensor>

            <sensor name="color_camera" type="camera">
                <gz_frame_id>camera_color_optical_frame</gz_frame_id>
                <pose>0 0.015 0 0 0 0</pose>
                <camera>
                    <horizontal_fov>1.20428</horizontal_fov>
                    <image>
                        <width>1280</width>
                        <height>720</height>
                    </image>
                    <clip>
                        <near>0.1</near>
                        <far>100</far>
                    </clip>
                </camera>
                <always_on>1</always_on>
                <update_rate>30</update_rate>
                <visualize>true</visualize>
                <topic>color_camera</topic>
            </sensor>
        </link>
    </model>
</sdf>
